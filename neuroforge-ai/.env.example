# ---------- Application ----------
APP_ENV=development            # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---------- Database ----------
# Local default is SQLite so the backend runs with zero infrastructure.
# Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./storage/neuroforge.db
# DATABASE_URL=postgresql+psycopg2://neuroforge:neuroforge@localhost:5432/neuroforge

# ---------- Background jobs ----------
# inline = in-process thread pool (no Redis needed); celery = Redis-backed workers
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# ---------- Object storage ----------
STORAGE_BACKEND=local          # local | s3
STORAGE_DIR=./storage/documents
S3_BUCKET=
S3_ENDPOINT_URL=               # set for MinIO / R2 / other S3-compatible stores
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Upload limits ----------
MAX_UPLOAD_MB=50
MAX_PAGES=500

# ---------- Auth ----------
AUTH_ENABLED=true
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=480
SEED_ADMIN_EMAIL=admin@neuroforge.local
SEED_ADMIN_PASSWORD=neuroforge-admin
SEED_ADMIN_NAME=Platform Admin

# ---------- LLM provider (server side only; never sent to the browser) ----------
# extractive = local, deterministic, evidence-only answer composer (no key needed)
# openai | anthropic | openai_compatible
LLM_PROVIDER=extractive
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=                  # for openai_compatible (Ollama, vLLM, LM Studio, ...)
LLM_TIMEOUT_SECONDS=60

# ---------- Embeddings ----------
# hashing = dependency-free local encoder; sbert = sentence-transformers (pip install -e ".[sbert]")
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=1024

# ---------- OCR / NLP ----------
OCR_ENGINE=auto                # auto | rapidocr | tesseract | none
OCR_MIN_CHARS_PER_PAGE=40
SPACY_MODEL=en_core_web_sm

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
