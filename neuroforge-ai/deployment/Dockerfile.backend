# syntax=docker/dockerfile:1
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# libgomp: onnxruntime (OCR); libglib/libgl are not needed because opencv-python-headless is used.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml alembic.ini ./
COPY backend ./backend
RUN pip install . && python -m spacy download en_core_web_sm

# Non-root runtime user; storage is a mounted volume.
RUN useradd --create-home --uid 10001 neuroforge && mkdir -p /data/storage && chown -R neuroforge /data /app
USER neuroforge
ENV PYTHONPATH=/app/backend STORAGE_DIR=/data/storage/documents

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 CMD curl -fsS http://localhost:8000/api/v1/health || exit 1

# Migrations run on start (idempotent), then the API.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers"]
